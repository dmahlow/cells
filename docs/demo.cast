[8.9677, "o", "\u001b[1;86H\u001b[38;5;239m \u001b[2;84H \u001b(B\u001b[0;1m\u001b[38;5;222m/\u2500\u001b(B\u001b[0m\u001b[38;5;239m  \u001b[4d\b\b\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u001b[8;78H\u001b(B\u001b[0m\u001b[38;5;196m\u2502\u001b[11d\\\u001b[23;27H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2502\u001b[24;21H\u001b(B\u001b[0m\u001b[38;5;239m \u001b[38;5;250m\u00b7\u001b[24;50H\u001b[38;5;231m\\\u001b[25;47H\u001b[38;5;69m\\\u001b[38;5;23m\u00b7 \u001b[26;10H\u001b[38;5;239m  \u001b[26;46H\u001b[38;5;69m/\u001b[27;7H\u001b[38;5;230m\\\u001b[38;5;250m.\u001b[38;5;230m\u2500\u2500\u2500\u2500\u001b[27;46H\u001b[38;5;69m\u2502\\\u001b[28;12H\u001b[38;5;230m\u2500\u001b[28;47H\u001b[38;5;23m\u00b7\u001b[29;10H\u001b[38;5;239m \u001b[29;40H\u001b[38;5;222m\u2500/\u001b[38;5;239m \u001b[49G\u001b[38;5;231m\u2500\u001b[30d\b\b\u001b[38;5;239m \u001b[31;15H\u001b[38;5;69m\\\u001b[33;9H\u001b[38;5;239m \u001b[38;5;69m//\u001b[38;5;239m \u001b[38;5;69m\\\u001b[34d\\\u2502\u001b[35d\b/\u001b[36;62H\u001b[38;5;239m \u001b[39m\u001b(B\u001b[m"]
[9.0282, "o", "\u001b[1;86H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u2500\\\\\u001b(B\u001b[0m\u001b[38;5;222m\u2500\u001b[10;87H\u001b[38;5;196m\u2502\u001b[16;75H\u001b[38;5;23m\u00b7\u001b[38;5;115m\u2502\u001b[16;98H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u001b[17;102H\u001b(B\u001b[0m\u001b[38;5;222m\u2500\u001b[18d\\\u2500\u001b[22;21H\u001b[38;5;239m \u001b[24;30H\u001b[38;5;222m\\\\\\\u001b[24;43H\u001b[38;5;108m/\u2500\u2500\u2500\u001b[38;5;115m\\\\\\\\\u001b[25;16H\u001b[38;5;239m \u001b[25;27H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2502\u001b(B\u001b[0m\u001b[38;5;239m    \u001b[38;5;222m\u2502\u001b[25;41H\u001b[38;5;239m \u001b[38;5;108m//\u001b[38;5;23m   \u001b[38;5;69m\\\\\u001b[26;32H\u001b[38;5;222m\u2502\u001b[26;41H\u001b[38;5;108m/\u001b[38;5;23m  \u001b[38;5;69m/\\///\u001b[38;5;23m  \u001b[38;5;115m\\\\\u2500\u001b[27;31H\u001b(B\u001b[0;1m\u001b[38;5;222m/\u2500\u2500\\\u001b[41G\u001b(B\u001b[0m\u001b[38;5;108m\u2502\u001b[38;5;23m\u00b7 \u001b[38;5;69m\u2502//\u2500/\u001b[38;5;23m \u00b7\u001b[38;5;108m//\u001b[28;7H\u001b[38;5;230m\\\u2500\u2500\\\u001b[38;5;250m\u25cf\u001b[38;5;239m   \u001b[28;30H \u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u001b(B\u001b[0m\u001b[38;5;239m \u001b[38;5;250m~\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u2502\u001b(B\u001b[0m\u001b[38;5;239m      \u001b[38;5;108m\\\\\u001b[50G//\u001b[29;30H\u001b[38;5;239m \u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\\\u001b(B\u001b[0m\u001b[38;5;239m \u001b(B\u001b[0;1m\u001b[38;5;222m/\u2502\u001b(B\u001b[0m\u001b[38;5;239m       \u001b[38;5;108m\\\\\u2500\u2500\u2500\u2500\u2500\u001b[38;5;250m\u25cf\u001b[30;32H\u001b(B\u001b[0;1m\u001b[38;5;222m\\\u2500\u2500\u001b[31;15H\u001b(B\u001b[0m\u001b[38;5;69m\u2502\u001b[32;10H\\\u001b[33;13H/\u001b[36;63H\u2502\\\u2500\u001b[39m\u001b(B\u001b[m"]
