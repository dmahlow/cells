[1.8538, "o", "\u001b[1;50H\u001b[38;5;69m\u2500\u2502\u001b[2;3H\u001b[38;5;239m \u001b[2;52H\u001b[38;5;69m\u2500\u001b[3;4H/\u2500\\\u2500\\\\\u2500/\u001b[3;51H\\\u001b[4;5H\\\u001b[10;72H\u001b[38;5;239m \u001b[11;74H\u001b[38;5;196m\\\u001b[13;83H\u001b[13;102H\u001b[38;5;239m \u001b[38;5;222m\\\u001b[14d\b\u2502\u001b[15;101H\u2502\u001b[15;112H\u001b[38;5;230m\u2502\u2500\u2500\u001b[16d\b\\\u2502\u001b[17d\b\u2502\\\u001b[18;99H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u001b[19;118H\u001b(B\u001b[0m\u001b[38;5;239m \u001b[38;5;230m\\\\\u001b[20;13H\u001b(B\u001b[0;1m\u001b[38;5;69m/\u2500\u2500\u2500\u2500\\\\\u001b[117G\u001b(B\u001b[0m\u001b[38;5;230m\u2502\u001b[38;5;239m  \u001b[21;13H\u001b(B\u001b[0;1m\u001b[38;5;69m/\u001b(B\u001b[0m\u001b[38;5;239m     \u001b(B\u001b[0;1m\u001b[38;5;69m\\\u001b[119G\u001b(B\u001b[0m\u001b[38;5;250m\u25cf\u001b[22;12H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2502\u001b[23d\b\b\u001b(B\u001b[0m\u001b[38;5;239m \u001b[119G \u001b[27;52H\u001b[38;5;115m\\\u001b[28;61H\u001b[38;5;239m \u00b7:\u001b[30;50H \u001b[31d\b\b\u001b[38;5;180m\u2500\u001b[31;92H\u001b[38;5;239m \u001b[32d\b\b\u001b[38;5;222m/\u001b[34d\u001b(B\u001b[0;1m\u001b[38;5;222m\\\u001b[36;90H\u001b(B\u001b[0m\u001b[38;5;239m \u001b[39m\u001b(B\u001b[m"]
