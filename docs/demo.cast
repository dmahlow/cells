[2.9308, "o", "\u001b[1;51H\u001b[38;5;69m\u2502\u2500/\\\u2502\u001b[2;52H\u001b[38;5;239m \u001b[38;5;69m\u2500\u2500\u2502\u2502\u2500\u2500\u001b[3;51H\u001b[38;5;239m \u001b[4;54H\u001b[38;5;69m\u2500\u001b[9;82H\u001b[38;5;196m\\\u2502\u001b[17;107H\u001b[38;5;222m\u2500\\\\\u001b[18;101H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u001b[21;2H\u001b(B\u001b[0m\u001b[38;5;239m \u001b[38;5;250m\u25cf\u001b[21;17H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2500\u001b[22;2H\u001b(B\u001b[0m\u001b[38;5;230m/\u2500\u2500\u2500\u2500\u001b[23;40H\u001b[38;5;222m/\u001b[24;19H\u001b[38;5;239m \u001b(B\u001b[0;1m\u001b[38;5;69m\u2500\u001b[38;5;154m>-\u001b[26;37H\u001b(B\u001b[0m\u001b[38;5;239m \u001b[27;35H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u2502\u001b(B\u001b[0m\u001b[38;5;250m~\u001b(B\u001b[0;1m\u001b[38;5;222m//\u001b(B\u001b[0m\u001b[38;5;239m \u001b[38;5;69m/\u001b[38;5;23m\u00b7\u001b[28;47H\u001b[38;5;69m/\u001b[35;88H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u2500\u2500\u2500\u2502\u001b(B\u001b[0m\u001b[38;5;222m//\u001b[36;88H\u001b[38;5;239m \u001b[39m\u001b(B\u001b[m"]
[3.002, "o", "\u001b[1;50H\u001b[38;5;239m \u001b[38;5;69m\u2502\u2500\u2500\u2500\u2502\u2500\u2500\u001b[2;9H\u2500\u001b[3d\b\b\\\u001b[3;53H\u001b[38;5;239m \u001b[4;7H \u001b[9;80H\u001b[38;5;88m \u001b[18;98H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u001b[105G\u001b(B\u001b[0m\u001b[38;5;222m\u2500\r\u001b[20d\u001b[38;5;230m\u2500//\u2500\u2500\u2500\u2500\u2500//\u001b[17G\u001b[38;5;239m\u00b7:\r\u001b[21d\u001b[38;5;230m\u2500\u001b[38;5;239m \u001b[38;5;250m\u25cf\u001b[38;5;230m\u2500\u2500\u2500\u001b[22d\b\b\u001b[38;5;239m  \u001b[22;39H \u001b[23;21H \u001b[24;13H \u001b(B\u001b[0;1m\u001b[38;5;69m\u2502\\\u001b(B\u001b[0m\u001b[38;5;239m    \u001b(B\u001b[0;1m\u001b[38;5;69m/\u001b[24;39H\u001b(B\u001b[0m\u001b[38;5;222m\u2502\u001b[25;20H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2500\u001b[26;47H\u001b(B\u001b[0m\u001b[38;5;69m\u2500\u001b[27;42H/\u001b[28;53H\u001b[38;5;180m\\\u001b[29;48H\u001b[38;5;69m\u2500\u001b[33;97H\u001b[38;5;222m//\u001b[34d\b\b\u2502\u001b[35;94H\u001b[38;5;239m \u001b[36;86H\u001b(B\u001b[0;1m\u001b[38;5;222m\\\u001b[39m\u001b(B\u001b[m"]
[3.0679, "o", "\u001b[1;50H\u001b[38;5;69m/\u2500\\\u2502\u2500\u2502\\\u2500/\u001b[2;8H\\\u001b[2;50H\\\\\u2500\u2502\u2500\u2500\u001b[C\u001b[38;5;239m\u001b[K\u001b[3;6H\u001b[38;5;69m\u2500/\u2500\u001b[38;5;239m \u001b[3;52H  \u001b[38;5;69m/\\\\\u001b[4;5H\u2500\u001b[4;52H\u001b[38;5;239m  \u001b[38;5;69m\\\u2500/\u001b[5;19H\u001b[38;5;239m \u00b7:\u001b[7;75H\u001b[38;5;196m/\u001b[82G\u2500\u001b[17;101H\u001b[38;5;239m      \u001b[19;103H \u001b[20;2H\u001b[38;5;230m\u2500\u001b[21;9H/\r\u001b[22d\u2500////\u001b[23;17H\u001b[38;5;239m \u001b[38;5;250m\u00b7\u001b[23;47H\u001b[38;5;115m\\\u001b[24;38H\u001b[38;5;222m\\\u001b[25;36H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u2500\\\u001b[26;50H\u001b(B\u001b[0m\u001b[38;5;23m \u001b[27;36H\u001b[38;5;239m \u001b[38;5;250m~\u001b(B\u001b[0;1m\u001b[38;5;222m/\u2502\u001b[28;35H\\\u001b[28;47H\u001b(B\u001b[0m\u001b[38;5;69m\\\u001b[33;98H\u001b[38;5;239m \u001b[34;96H\u001b[38;5;222m\u2500\u001b[35;91H\u001b(B\u001b[0;1m\u001b[38;5;222m\\\u2502\u001b(B\u001b[0m\u001b[38;5;222m//\u001b[39m\u001b(B\u001b[m"]
[3.1345, "o", "\u001b[1;6H\u001b[38;5;69m\\\u001b[1;53H/\u001b[2;12H/\u001b[2;54H/\u2500\\\u001b[3;8H\u001b[38;5;239m  \u001b[38;5;69m\\\u001b[3;55H\u001b[38;5;239m \u001b[4;53H\u001b[1K \u001b[38;5;69m\\\\\u2500\r\u001b[6d\u001b[6;39H\u001b[38;5;239m .\u001b[10;74H\u001b[38;5;196m\u2502\u001b[11d\\\u001b[12;82H/\u001b[17;107H\u001b[38;5;222m/\u001b[18d\b/\u001b[19;98H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u001b[20;3H\u001b(B\u001b[0m\u001b[38;5;230m\u2500\r\u001b[21d\u001b[38;5;239m  \u001b[38;5;250m\u25cf\u001b[38;5;230m/\u2500\u2500\u2500\u001b[22;21H\u001b(B\u001b[0;1m\u001b[38;5;69m\\\u001b[22;40H\u001b(B\u001b[0m\u001b[38;5;222m/\u001b[23;14H\u001b(B\u001b[0;1m\u001b[38;5;69m\u2502\u001b[24;39H\u001b(B\u001b[0m\u001b[38;5;222m\\\u001b[26;45H\u001b[38;5;69m\\\u001b[27;36H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u001b[43G\u001b(B\u001b[0m\u001b[38;5;69m\\\u001b[33;97H\u001b[38;5;239m \u001b[38;5;222m\u2502\u001b[36;92H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u001b[39m\u001b(B\u001b[m"]
[3.2018, "o", "\u001b[3;4H\u001b[38;5;69m\u2502\u001b[3;57H/\u001b[7;75H\u001b[38;5;239m \u001b[8;81H\u001b[38;5;196m\u2500\u001b[9;76H\u001b[38;5;88m \u001b[10;85H\u001b[38;5;196m\u2502\u001b[11;77H\u001b[38;5;88m \u2591\u2591  \u001b[38;5;196m//\u001b[14;44H\u001b[38;5;239m \u00b7:\u001b[18;102H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u2502\u001b(B\u001b[0m\u001b[38;5;222m\u2500\u2500\u2500\u001b[21;4H\u001b[38;5;239m \u001b[22;2H\u001b[38;5;230m\u2500////\u001b[22;39H\u001b[38;5;222m\u2500\u001b[23d\b\u2500\u001b[38;5;239m \u001b[24;20H \u001b[25;15H\u001b(B\u001b[0;1m\u001b[38;5;69m\\\u001b[25;36H\u001b(B\u001b[0m\u001b[38;5;239m \u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\\\u001b(B\u001b[0m\u001b[38;5;239m \u001b[114G.\u001b[26;35H\u001b(B\u001b[0;1m\u001b[38;5;222m\u2502\u2500\u001b(B\u001b[0m\u001b[38;5;239m \u001b(B\u001b[0;1m\u001b[38;5;222m\\\u001b[26;64H\u001b(B\u001b[0m\u001b[38;5;239m\u001b[K\u001b[27;36H \u001b[28d\b\u001b(B\u001b[0;1m\u001b[38;5;222m\u2500\u001b[29;54H\u001b(B\u001b[0m\u001b[38;5;180m\u2502\u001b[30;48H\u2502\\\u001b[33;98H\u001b[38;5;239m \u001b[34;94H\u001b[38;5;222m/\u2500\u2500\u2502\u2502\u001b[39m\u001b(B\u001b[m"]
